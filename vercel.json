{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fairdrop-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://fairdrop-api.onrender.com/auth/:path*" },
    { "source": "/drops/:path*", "destination": "https://fairdrop-api.onrender.com/drops/:path*" },
    { "source": "/admin/:path*", "destination": "https://fairdrop-api.onrender.com/admin/:path*" },
    { "source": "/baseline/:path*", "destination": "https://fairdrop-api.onrender.com/baseline/:path*" },
    { "source": "/healthz", "destination": "https://fairdrop-api.onrender.com/healthz" }
  ]
}
